# Copy jadi .env di folder ini (server deploy) — JANGAN commit .env asli.
# POSTGRES_DB, APP_RUNTIME_PASSWORD, REDIS_PASSWORD harus sama dengan nexqia/infra/.env.
GITHUB_USERNAME=your-github-username
API_VERSION=latest
POSTGRES_DB=nexqia
APP_RUNTIME_PASSWORD=changeme
REDIS_PASSWORD=changeme

# Domain untuk reverse proxy nginx host — lihat nginx.conf.template
API_DOMAIN=api.yourdomain.com
