# Copy jadi .env untuk dev lokal — JANGAN commit .env asli.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexqia

APP_RUNTIME_USER=app_runtime
APP_RUNTIME_PASSWORD=app_runtime_dev_password

HTTP_PORT=8080

# Harus sama persis dengan REDIS_PASSWORD di infra/.env (Redis wajib auth, gak boleh kosong).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# Dipakai `make migrate-up`/`migrate-down` saja (butuh role owner Postgres, bukan app_runtime).
# Samain user/password/db dengan POSTGRES_USER/PASSWORD/DB di infra/.env.
DATABASE_URL=postgres://nexqia:nexqia@localhost:5432/nexqia?sslmode=disable

# Key simetris pgcrypto pgp_sym_encrypt buat core.person.nik — dipakai `make seed` sekarang,
# nanti dipakai app layer juga pas core.person query ditulis. WAJIB sama persis di semua environment
# yang perlu decrypt data yang sama (rotate key = data lama gak bisa didekripsi lagi).
NIK_ENCRYPTION_KEY=dev-only-change-me
