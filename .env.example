# Copy jadi .env untuk dev lokal — JANGAN commit .env asli.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexqia

APP_RUNTIME_USER=app_runtime
APP_RUNTIME_PASSWORD=app_runtime_dev_password

HTTP_PORT=8080

# Harus sama persis dengan REDIS_PASSWORD di infra/.env (Redis wajib auth, gak boleh kosong).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# Dipakai `make migrate-up`/`migrate-down` saja (butuh role owner Postgres, bukan app_runtime).
# Samain user/password/db dengan POSTGRES_USER/PASSWORD/DB di infra/.env.
DATABASE_URL=postgres://nexqia:nexqia@localhost:5432/nexqia?sslmode=disable

# Key simetris pgcrypto pgp_sym_encrypt buat core.person.nik — dipakai `make seed` sekarang,
# nanti dipakai app layer juga pas core.person query ditulis. WAJIB sama persis di semua environment
# yang perlu decrypt data yang sama (rotate key = data lama gak bisa didekripsi lagi).
NIK_ENCRYPTION_KEY=dev-only-change-me

# Secret buat sign/verify JWT session token (internal/auth) — wajib diisi, rotate = semua token aktif invalid.
JWT_SECRET=dev-only-change-me

# Rate limiting (internal/ratelimit, internal/server/ratelimit.go) — semua nilai boleh
# diubah tanpa redeploy kode. Default aman untuk 1 fasilitas kecil; naikkan
# RATE_LIMIT_API_* kalau frontend butuh polling lebih sering.
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_API_TOKENS_PER_MINUTE=100
RATE_LIMIT_API_BURST=20

# Parameter Argon2id (internal/auth/password.go) — rekomendasi OWASP saat ini.
# Naikkan ARGON2_MEMORY_KIB/ARGON2_ITERATIONS seiring waktu kalau hardware server
# makin kuat (password lama tetap valid, parameter ikut ke-embed di tiap hash).
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# Concurrency limiter untuk operasi hash password (internal/auth/hasher.go) — mencegah
# banyak login/register bersamaan menghabiskan CPU/RAM instance ini secara paralel.
# PASSWORD_HASH_MAX_CONCURRENT default ke jumlah CPU core kalau tidak diisi.
PASSWORD_HASH_MAX_CONCURRENT=
PASSWORD_HASH_QUEUE_TIMEOUT_MS=2000

# Session/refresh-token model (internal/session, docs/design/specs/2026-09-15-session-refresh-token-design.md).
# ACCESS_TOKEN_TTL_MINUTES: umur JWT akses. REFRESH_TOKEN_IDLE_TIMEOUT_HOURS: sesi mati
# kalau tidak ada refresh sama sekali selama sekian jam (tier "logout total", terpisah
# dari PIN-unlock yang menangani idle jangka pendek). REFRESH_TOKEN_ABSOLUTE_TTL_DAYS:
# batas geser (reset tiap refresh sukses) selama sesi tetap aktif dipakai.
# COOKIE_SECURE: matikan (false) hanya untuk dev HTTP lokal tanpa TLS, WAJIB true di production.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_IDLE_TIMEOUT_HOURS=24
REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=30
COOKIE_SECURE=true
